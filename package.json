{
  "name": "pixelgba",
  "version": "1.3.0",
  "private": true,
  "description": "Static Game Boy Advance emulator UI using EmulatorJS and mGBA",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node serve.js 8080",
    "build:icons": "node scripts/generate-icons.mjs",
    "build:meta": "node scripts/generate-build-info.mjs",
    "build:pages": "npm run check && node scripts/prepare-deploy.mjs",
    "check": "node scripts/generate-icons.mjs --check && node scripts/generate-build-info.mjs --check && node scripts/check-assets.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:cross-browser": "playwright test --project=firefox --project=webkit",
    "test:all": "npm run check && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sparticuz/chromium": "153.0.0",
    "fake-indexeddb": "6.2.4",
    "jsdom": "27.2.0"
  }
}
